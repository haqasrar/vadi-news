{
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-community/php@0.4.0"
        }
    },
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/api/admin/index.php"
        },
        {
            "source": "/admin/:path*",
            "destination": "/api/admin/:path*"
        },
        {
            "source": "/api/share.php",
            "destination": "/api/share.php"
        },
        {
            "source": "/api/post_ticker.php",
            "destination": "/api/post_ticker.php"
        },
        {
            "source": "/api/delete_news.php",
            "destination": "/api/delete_news.php"
        },
        {
            "source": "/api/update_ads.php",
            "destination": "/api/update_ads.php"
        },
        {
            "source": "/news/:id",
            "destination": "/api/share.php?id=:id"
        }
    ]
}